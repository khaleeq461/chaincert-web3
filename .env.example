# ==============================================================================
# ChainCert — Decentralized Certificate Verification Platform Environment Config
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Blockchain Network & Smart Contract Configuration
# ------------------------------------------------------------------------------
# Target EVM Chain ID:
#   - 31337    : Local Hardhat Node (http://127.0.0.1:8545)
#   - 11155111 : Ethereum Sepolia Testnet
NEXT_PUBLIC_CHAIN_ID=31337

# Public JSON-RPC Endpoint (used by viem for zero-wallet queries & verification)
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# Deployed ChainCert.sol Smart Contract Address
NEXT_PUBLIC_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Blockchain Explorer URL for transaction and contract inspection
NEXT_PUBLIC_BLOCK_EXPLORER_URL=http://localhost:8545

# ------------------------------------------------------------------------------
# 2. Decentralized IPFS Storage Configuration
# ------------------------------------------------------------------------------
# How to configure real IPFS storage with Pinata:
# 1. Sign up at https://pinata.cloud/
# 2. Go to "API Keys" -> Generate New Key (enable 'pinFileToIPFS' & 'pinJSONToIPFS')
# 3. Copy the JWT token into PINATA_JWT below
#
# NOTE: If PINATA_JWT is left empty, ChainCert automatically falls back to the
# built-in LocalMockStorageAdapter. This computes authentic IPFS CIDv1 multihashes
# (e.g. bafkrei...) and serves pinned content via /api/ipfs/[cid] without requiring
# external API keys.

# Pinata JWT (Recommended for production):
PINATA_JWT=

# Pinata API Key & Secret (Legacy alternative to JWT):
PINATA_API_KEY=
PINATA_API_SECRET=

# IPFS Gateway URL for retrieving documents and metadata:
# Examples:
#   - https://gateway.pinata.cloud/ipfs/
#   - https://cloudflare-ipfs.com/ipfs/
#   - https://<YOUR_CUSTOM_GATEWAY>.mypinata.cloud/ipfs/
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# ------------------------------------------------------------------------------
# 3. Contract Deployment & Hardhat Development (Contracts Workspace Only)
# ------------------------------------------------------------------------------
# Local Hardhat Node Account #0 Private Key (Pre-funded with 10,000 test ETH)
# CAUTION: NEVER put a mainnet private key with real funds here!
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Sepolia RPC URL (for deploying to testnet, e.g. via Alchemy or Infura)
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Etherscan API Key for automated smart contract verification
ETHERSCAN_API_KEY=
